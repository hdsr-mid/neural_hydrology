# Kopieer naar repo-root: cp .env.example .env
# Prioriteit: shell-export > .env > ingebouwde defaults. Relatieve paden zijn t.o.v. NEURAL_HYDROLOGY_ROOT.

# --- Projectroot ---
NEURAL_HYDROLOGY_ROOT=  # lokaal: leeg (auto repo-root) | Databricks: /Workspace/Shared/neural_hydrology_fork

# --- Paden (relatief aan NEURAL_HYDROLOGY_ROOT, tenzij absoluut pad) ---
DATA_DIR=data  # lokaal: data/ | Databricks: vaak Volume input, bv. /Volumes/.../data_neuralhydrology/input
DATA_ENS_DIR=data_ens  # operationele NetCDF-input; lokaal: data_ens/, Databricks: /Volumes/dbw_datascience_tst_weu_001/default/data_neuralhydrology/operationeel/input
INFERENCE_RUNS_DIR=inference_runs  # inference-output; lokaal: inference_runs/, Databricks: /Volumes/dbw_datascience_tst_weu_001/default/data_neuralhydrology/output/inference
CONFIG_PATH=config.yml  # training-config; lokaal config.yml | Databricks: /Workspace/Shared/neural_hydrology/config.yml
RUNS_DIR=runs  # lokale modelruns; lokaal: runs/, Databricks: /Volumes/dbw_datascience_tst_weu_001/default/data_neuralhydrology/output
BEST_MODEL_DIR_1=runs/<run_id_1>  # verplicht voor jobs/run_ensembles.py (bagging, config.yml)
BEST_MODEL_DIR_2=runs/<run_id_2>
BEST_MODEL_DIR_3=runs/<run_id_3>
BEST_MODEL_DIR_4=runs/<run_id_4>
BEST_MODEL_DIR_5=runs/<run_id_5>
N_ENSEMBLES=30  # aantal HARMONIE-ensembleleden bij inference (default 30)
OUTPUT_DIR=runs  # lokaal: runs/ | Databricks: /Volumes/dbw_datascience_tst_weu_001/default/data_neuralhydrology/output
BASE_CONFIG=  # leeg = CONFIG_PATH | Databricks: /Workspace/Shared/neural_hydrology/config.yml
HPO_OUTPUT_DIR=  # leeg = OUTPUT_DIR/HPO
RETRAIN_BASE_DIR=  # leeg = OUTPUT_DIR/BATCH_RETRAIN

# --- MLflow (vooral Databricks) ---
MLFLOW_TRACKING_URI=  # lokaal: leeg | Databricks: databricks

# --- KNMI Open Data (preprocessing) ---
KNMI_API_URL=https://api.dataplatform.knmi.nl/open-data  # meestal niet wijzigen
KNMI_API_KEY=  # verplicht voor preprocessing; jouw KNMI API-sleutel

# --- HARMONIE / ensemble preprocessing ---
ENSEMBLE_STARTTIME=  # optioneel; YYYYMMDDHH UTC, bv. 2026040718 (oudste run in 6-uurs venster)
DOWNLOAD_ENSEMBLE=1  # 1 = download .tar van KNMI | 0 = alleen cache in data_ens/_tmp_harmonie/

# --- best_model.py (optioneel) ---
SOURCE_EXPERIMENT_NAME=  # bv. /Shared/hdsr_lstm_optuna_20260319_120530
SOURCE_TRIAL_NUMBER=0  # trial-nummer uit MLflow

# --- postprocess_ensembles.py (Databricks Unity Catalog) ---
ENSEMBLE_FORECAST_TABLE=dbw_datascience_tst_weu_001.default.output_forecast  # verplicht; TRUNCATE + reload per run
